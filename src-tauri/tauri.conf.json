{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blackbox",
  "version": "0.1.0",
  "identifier": "app.blackbox.recorder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Blackbox",
    "category": "Utility",
    "shortDescription": "Flight recorder for Windows performance",
    "longDescription": "Blackbox records kernel, driver, disk, CPU, GPU and app activity at near-zero cost and explains every stutter, freeze and latency spike.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
